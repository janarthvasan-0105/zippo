---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Poster from '../components/Poster.astro';
import WaitlistBand from '../components/WaitlistBand.astro';
import { getDict, getLocale, fmt } from '../i18n';
import { shows } from '../data/shows';
import { LAUNCH_DATE } from '../config';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = getDict(lang);
const c = t.comingSoon;
const upcoming = shows.filter((s) => s.release !== 'launch');
const month = new Intl.DateTimeFormat(getLocale(lang).hreflang, { month: 'long', year: 'numeric', timeZone: 'UTC' });
const units = [
  { key: 'd', label: c.days },
  { key: 'h', label: c.hours },
  { key: 'm', label: c.minutes },
  { key: 's', label: c.seconds },
];
---

<Base lang={lang} page="comingSoon" title={c.title} description={c.description}>
  <PageHeader heading={c.heading} subtitle={c.subtitle} />

  <section class="container-x">
    <div id="countdown" data-launch={LAUNCH_DATE} class="grid max-w-2xl grid-cols-4 gap-3 sm:gap-4" dir="ltr">
      {
        units.map((u) => (
          <div class="card px-2 py-5 text-center sm:py-7">
            <span data-unit={u.key} class="font-display block text-3xl font-bold tabular-nums sm:text-5xl">
              --
            </span>
            <span class="mt-1 block text-xs text-mist sm:text-sm">{u.label}</span>
          </div>
        ))
      }
    </div>
    <p class="mt-3 text-sm text-mist">{c.dateNote}</p>
  </section>

  <section class="container-x mt-24">
    <h2 class="font-display text-3xl font-bold sm:text-5xl">{c.slateTitle}</h2>
    <p class="mt-4 text-lg text-mist">{c.slateSubtitle}</p>
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3">
      {
        upcoming.map((show) => (
          <li>
            <Poster show={show} lang={lang} sizes="(min-width: 640px) 30vw, 45vw" />
            <p class="mt-2 text-sm font-semibold text-ice">{fmt(t.shows.premieres, { date: month.format(new Date(`${show.release}-01T00:00:00Z`)) })}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-mist">{t.sample.note}</p>
  </section>

  <WaitlistBand lang={lang} />
</Base>

<script>
  const el = document.getElementById('countdown');
  if (el) {
    const target = Date.parse(el.dataset.launch!);
    const cells = Object.fromEntries([...el.querySelectorAll<HTMLElement>('[data-unit]')].map((n) => [n.dataset.unit, n]));
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const left = Math.max(0, target - Date.now()) / 1000;
      cells.d.textContent = String(Math.floor(left / 86400));
      cells.h.textContent = pad(Math.floor((left % 86400) / 3600));
      cells.m.textContent = pad(Math.floor((left % 3600) / 60));
      cells.s.textContent = pad(Math.floor(left % 60));
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
