---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import WaitlistBand from '../components/WaitlistBand.astro';
import { getDict, href, fmt } from '../i18n';
import { genres, showsIn, photo } from '../data/shows';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = getDict(lang);
---

<Base lang={lang} page="genres" title={t.genres.title} description={t.genres.description}>
  <PageHeader heading={t.genres.heading} subtitle={t.genres.subtitle} />

  <section class="container-x grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      genres.map((g) => {
        const list = showsIn(g);
        const name = t.genres.names[g];
        return (
          <a
            href={`${href(lang, 'shows')}?genre=${g}`}
            class="group card relative block overflow-hidden p-0 transition hover:border-ice/50"
            aria-label={fmt(t.genres.browse, { genre: name })}
          >
            <div class="relative grid h-56 grid-cols-2 gap-1 overflow-hidden">
              {list.slice(0, 2).map((s) => (
                <Image
                  src={photo(s.slug)}
                  alt=""
                  widths={[240, 400]}
                  sizes="(min-width: 1024px) 190px, (min-width: 640px) 25vw, 50vw"
                  class="size-full object-cover saturate-[.7] transition duration-700 group-hover:scale-105"
                />
              ))}
              <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent" />
              <span class="absolute start-3 top-3 rounded-full border border-ice/30 bg-ink/60 px-2.5 py-1 text-[10px] font-semibold tracking-wider uppercase backdrop-blur">
                {t.sample.badge}
              </span>
            </div>
            <div class="p-6">
              <div class="flex items-baseline justify-between gap-3">
                <h2 class="font-display text-3xl font-bold">{name}</h2>
                <span class="text-sm text-mist">{fmt(t.genres.count, { n: list.length })}</span>
              </div>
              <p class="mt-2 text-mist">{t.genres.blurbs[g]}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-ice">
                {fmt(t.genres.browse, { genre: name })}
                <span aria-hidden="true" class="transition group-hover:translate-x-1 rtl:-scale-x-100 rtl:group-hover:-translate-x-1">→</span>
              </span>
            </div>
          </a>
        );
      })
    }
  </section>

  <WaitlistBand lang={lang} />
</Base>
