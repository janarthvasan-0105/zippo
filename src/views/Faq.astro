---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import WaitlistBand from '../components/WaitlistBand.astro';
import { getDict, href } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = getDict(lang).faq;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

<Base lang={lang} page="faq" title={t.title} description={t.description} jsonLd={[faqLd]}>
  <PageHeader heading={t.heading} subtitle={t.subtitle} />

  <section class="container-x max-w-3xl">
    <div class="space-y-3">
      {
        t.items.map((item, i) => (
          <details class="group card px-6 py-5" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
              {item.q}
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-steel/50 transition group-open:rotate-45" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 text-mist">{item.a}</p>
          </details>
        ))
      }
    </div>
    <p class="mt-10 text-mist">
      {t.more}
      <a href={href(lang, 'contact')} class="font-semibold text-ice underline underline-offset-4">{t.contact}</a>
    </p>
  </section>

  <WaitlistBand lang={lang} />
</Base>
