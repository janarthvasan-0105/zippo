---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import WaitlistBand from '../components/WaitlistBand.astro';
import { getDict } from '../i18n';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = getDict(lang).howItWorks;
---

<Base lang={lang} page="howItWorks" title={t.title} description={t.description}>
  <PageHeader heading={t.heading} subtitle={t.subtitle} />

  <section class="container-x">
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.steps.map((step, i) => (
          <li class="card p-7">
            <span class="flex size-12 items-center justify-center rounded-full bg-ice text-lg font-bold text-ink">{i + 1}</span>
            <h2 class="mt-5 text-xl font-semibold">{step.title}</h2>
            <p class="mt-2 text-mist">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-x mt-24">
    <h2 class="font-display text-3xl font-bold sm:text-5xl">{t.plansTitle}</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        t.plans.map((plan, i) => (
          <div class:list={['rounded-3xl border p-8', i === 2 ? 'border-ice/60 bg-gradient-to-b from-navy to-ink' : 'border-steel/20 bg-navy/40']}>
            <h3 class="font-display text-2xl font-bold">{plan.name}</h3>
            <p class="mt-3 text-mist">{plan.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-mist">{t.plansNote}</p>
  </section>

  <section class="container-x mt-24">
    <div class="card p-8 sm:p-12">
      <h2 class="font-display text-3xl font-bold">{t.devicesTitle}</h2>
      <p class="mt-3 max-w-2xl text-lg text-mist">{t.devicesBody}</p>
    </div>
  </section>

  <WaitlistBand lang={lang} />
</Base>
