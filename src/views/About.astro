---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import WaitlistBand from '../components/WaitlistBand.astro';
import { getDict } from '../i18n';
import { photo } from '../data/shows';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = getDict(lang).about;
---

<Base lang={lang} page="about" title={t.title} description={t.description}>
  <PageHeader heading={t.heading} subtitle={t.lead} />

  <section class="container-x grid items-start gap-12 lg:grid-cols-[1fr_1.2fr]">
    <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] border border-steel/20">
      <Image src={photo('hearts-bokeh')} alt="" widths={[400, 700]} sizes="(min-width: 1024px) 480px, 100vw" class="size-full object-cover saturate-[.7]" />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/80 to-transparent" aria-hidden="true"></div>
    </div>
    <div class="space-y-10">
      {
        t.sections.map((s) => (
          <div>
            <h2 class="font-display text-3xl font-bold">{s.title}</h2>
            <p class="mt-3 text-lg text-mist">{s.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <WaitlistBand lang={lang} />
</Base>
