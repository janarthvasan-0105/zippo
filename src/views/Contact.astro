---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Web3Form from '../components/Web3Form.astro';
import { getDict } from '../i18n';
import { EMAILS } from '../config';

interface Props {
  lang: string;
}
const { lang } = Astro.props;
const t = getDict(lang).contact;
const directs = [
  { label: t.topics.general, email: EMAILS.hello },
  { label: t.topics.support, email: EMAILS.support },
  { label: t.topics.press, email: EMAILS.press },
];
---

<Base lang={lang} page="contact" title={t.title} description={t.description}>
  <PageHeader heading={t.heading} subtitle={t.subtitle} />

  <section class="container-x grid gap-10 lg:grid-cols-[1.4fr_1fr]">
    <Web3Form kind="contact" lang={lang} sending={t.sending} success={t.success} error={t.error} class="card space-y-5 p-6 sm:p-10">
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="mb-2 block text-sm text-mist">{t.name}</span>
          <input name="name" required autocomplete="name" class="field" />
        </label>
        <label class="block">
          <span class="mb-2 block text-sm text-mist">{t.email}</span>
          <input name="email" type="email" required autocomplete="email" class="field" />
        </label>
      </div>
      <label class="block">
        <span class="mb-2 block text-sm text-mist">{t.topic}</span>
        <select name="topic" class="field">
          {Object.entries(t.topics).map(([k, v]) => <option value={k}>{v}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="mb-2 block text-sm text-mist">{t.message}</span>
        <textarea name="message" required rows="6" class="field"></textarea>
      </label>
      <button type="submit" class="btn btn-primary">{t.submit}</button>
    </Web3Form>

    <aside class="space-y-4">
      <p class="eyebrow">{t.direct}</p>
      {
        directs.map((d) => (
          <a href={`mailto:${d.email}`} class="card block p-6 transition hover:border-ice/50">
            <span class="block text-sm text-mist">{d.label}</span>
            <span class="mt-1 block font-semibold break-all text-ice" dir="ltr">{d.email}</span>
          </a>
        ))
      }
    </aside>
  </section>
</Base>
