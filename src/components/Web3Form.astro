---
// A form that posts to Web3Forms. With JS it submits in place and shows status messages;
// without JS it falls back to a normal POST.
import { WEB3FORMS_KEY } from '../config';

interface Props {
  /** Subject line of the notification email; also the analytics event name. */
  kind: 'waitlist' | 'contact' | 'pitch';
  lang: string;
  sending: string;
  success: string;
  error: string;
  class?: string;
}
const { kind, lang, sending, success, error, class: className } = Astro.props;
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class:list={['w3f', className]}
  data-kind={kind}
  data-sending={sending}
  data-success={success}
  data-error={error}
>
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value={`Zippo ${kind} (${lang})`} />
  <input type="hidden" name="form" value={kind} />
  <input type="hidden" name="language" value={lang} />
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
  <slot />
  <p class="w3f-status mt-3 min-h-6 text-sm" role="status" aria-live="polite"></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form.w3f')) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.w3f-status')!;
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const label = button.textContent;
      const { sending, success, error, kind } = form.dataset;
      button.disabled = true;
      button.textContent = sending!;
      status.className = 'w3f-status mt-3 min-h-6 text-sm text-mist';
      status.textContent = '';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.message);
        form.reset();
        status.className = 'w3f-status mt-3 min-h-6 text-sm text-ice';
        status.textContent = success!;
        (window as any).va?.('event', { name: `${kind}_submit`, data: { lang: document.documentElement.lang } });
      } catch {
        status.className = 'w3f-status mt-3 min-h-6 text-sm text-red-300';
        status.textContent = error!;
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
</script>
