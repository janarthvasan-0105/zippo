---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]} dir="ltr">
  <img src="/favicon.svg" alt="" width="32" height="32" class="size-8" />
  <span class="font-display text-2xl font-bold tracking-tight italic" style="font-family: 'Playfair Display Variable', Georgia, serif">zippo</span>
</span>
