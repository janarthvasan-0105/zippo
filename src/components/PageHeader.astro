---
interface Props {
  eyebrow?: string;
  heading: string;
  subtitle?: string;
}
const { eyebrow, heading, subtitle } = Astro.props;
---

<header class="relative overflow-hidden">
  <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="container-x relative pt-16 pb-10 sm:pt-24 sm:pb-14">
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h1 class="font-display max-w-3xl text-4xl leading-tight font-bold text-balance sm:text-6xl">{heading}</h1>
    {subtitle && <p class="mt-5 max-w-2xl text-lg text-mist sm:text-xl">{subtitle}</p>}
  </div>
</header>
